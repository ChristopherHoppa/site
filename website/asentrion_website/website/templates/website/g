<style>
    .submission-toast {
        position: fixed;
        top: max(22px, env(safe-area-inset-top, 0px));
        left: 50%;
        z-index: 2147483000;
        display: flex;
        align-items: center;
        gap: 14px;
        box-sizing: border-box;
        width: max-content;
        max-width: calc(100vw - 32px);
        padding: 15px 21px;
        border: 1px solid #29875e;
        border-radius: 12px;
        background: #0b2019;
        box-shadow: 0 15px 45px rgba(0, 0, 0, .3);
        color: #e3ffed;
        font-family: Arial, Helvetica, sans-serif;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translate(-50%, -20px);
        transition: opacity .45s ease,
                    visibility .45s ease,
                    transform .65s cubic-bezier(.2, .8, .2, 1);
    }

    .submission-toast.is-visible {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, 0);
    }

    .submission-toast-icon {
        display: grid;
        flex: 0 0 42px;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #17623e;
        color: #ffffff;
        font-size: 23px;
        font-weight: 700;
    }

    .submission-toast-content {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
        line-height: 1.4;
    }

    .submission-toast-content strong {
        color: #e3ffed;
        font-size: 14px;
        font-weight: 600;
    }

    .submission-toast-content span {
        color: #a8d9bc;
        font-size: 12px;
        line-height: 1.5;
    }

    @media (prefers-reduced-motion: reduce) {
        .submission-toast {
            transition: none;
        }
    }
</style>


</head>


